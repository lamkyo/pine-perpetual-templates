//@version=5
strategy("Mean Reversion with Funding Filter [Pro]", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=20, commission_type=strategy.commission.percent, commission_value=0.04, slippage=1)

// ==========================================
// 1. INPUT PARAMETERS
// ==========================================
grp_bb = "Bollinger Bands & RSI"
bbLen = input.int(20, "BB Period", group=grp_bb)
bbMult = input.float(2.0, "BB StdDev Multiplier", group=grp_bb)
rsiLen = input.int(14, "RSI Period", group=grp_bb)
rsiOversold = input.int(30, "RSI Oversold Level", group=grp_bb)
rsiOverbought = input.int(70, "RSI Overbought Level", group=grp_bb)

grp_funding = "Perpetual Funding Rate Filter"
useFundingFilter = input.bool(true, "Enable Funding Penalty Filter", group=grp_funding)
fundingSymbol = input.symbol("BINANCE:BTCUSDT_PERP_FUNDING", "Funding Rate Symbol", group=grp_funding)
maxAdverseFunding = input.float(0.0003, "Max Adverse Funding (0.03% / 8h)", group=grp_funding, tooltip="Do not enter counter-trend trade if funding decay is too expensive")

// ==========================================
// 2. INDICATORS
// ==========================================
[bbBasis, bbUpper, bbLower] = ta.bb(close, bbLen, bbMult)
rsi = ta.rsi(close, rsiLen)

fundingVal = request.security(fundingSymbol, "D", close, lookahead=barmerge.lookahead_off)
fundingValSafe = na(fundingVal) ? 0.0 : fundingVal

// Adverse funding checks:
// Longs pay funding when funding > 0
longFundingPenalty = useFundingFilter ? (fundingValSafe > maxAdverseFunding) : false
// Shorts pay funding when funding < 0
shortFundingPenalty = useFundingFilter ? (fundingValSafe < -maxAdverseFunding) : false

// ==========================================
// 3. STRATEGY EXECUTION
// ==========================================
longCondition = (close <= bbLower) and (rsi <= rsiOversold) and not longFundingPenalty
shortCondition = (close >= bbUpper) and (rsi >= rsiOverbought) and not shortFundingPenalty

if (longCondition and strategy.position_size <= 0)
    strategy.entry("Long MR", strategy.long)
    // Take profit at middle band, stop loss beyond recent swing
    strategy.exit("Exit Long MR", "Long MR", limit=bbBasis, stop=low[1] * 0.985)

if (shortCondition and strategy.position_size >= 0)
    strategy.entry("Short MR", strategy.short)
    // Take profit at middle band, stop loss beyond recent swing
    strategy.exit("Exit Short MR", "Short MR", limit=bbBasis, stop=high[1] * 1.015)

// Mean reversion completion: close at middle band
if (strategy.position_size > 0 and close >= bbBasis)
    strategy.close("Long MR", comment="Target BB Mid Reached")

if (strategy.position_size < 0 and close <= bbBasis)
    strategy.close("Short MR", comment="Target BB Mid Reached")

// ==========================================
// 4. VISUALS
// ==========================================
plot(bbUpper, "BB Upper", color=color.red)
plot(bbBasis, "BB Basis", color=color.blue)
plot(bbLower, "BB Lower", color=color.green)
